# 复制本文件为 .dev.vars 后填入真实值（.dev.vars 已 gitignore）
# 仅影响本地 wrangler dev（线上用 wrangler secret put 设置）

TG_Bot_Token = "你的_Telegram_Bot_Token"
TG_Chat_ID = "你的频道ID_如_-100xxxxxxxxxx"
JWT_SECRET = "足够长的随机字符串_须与旧站一致以便用户无缝登录"
ADMIN_USERNAME = "你的管理员用户名"
# 仅首次创建管理员时临时配置，创建成功后线上应删除
# ADMIN_BOOTSTRAP_TOKEN = "一次性高强度随机字符串"
# 建议独立于 JWT_SECRET；必须妥善保存，否则频道加密备份无法恢复
# BACKUP_ENCRYPTION_KEY = "备份专用高强度随机字符串"
# RESEND_API_KEY = "re_xxx"
# RESEND_FROM = "图床 <noreply@yourdomain.com>"
# SMTP_PASSWORD = "SMTP密码或授权码（仅测试旧版 Secret 回退；也可在后台配置）"
# NSFW_API_KEY = "鉴黄服务密钥"
# NSFW_EXTRA_PARAMS = "鉴黄服务附加查询参数"
# 仅本地开发可设为 1，让未配置邮件时返回验证码；禁止在线上启用
# ALLOW_DEV_CODE = "1"
