# 依赖与构建缓存
node_modules/
.wrangler/

# 本地真实配置（含密钥，切勿提交）
# wrangler.toml 已入库：密钥全部走 Cloudflare Secrets，文件内无敏感信息
# .dev.vars* 覆盖 wrangler 的按环境文件名（.dev.vars.production 等），
# 只豁免 .example 模板；仅写 .dev.vars 会漏掉这些变体。
.dev.vars*
!.dev.vars.example
.env
.env.*
!.env.example

# 数据库导出与备份产物（含用户邮箱、密码哈希，切勿提交）
# README 的 d1 export / 解密脚本默认就产出这些名字
*.sql
*.sql.gz
*.sql.enc
*.enc
duckimg-backup-*

# 迁移导出（含用户哈希/邮箱，切勿提交）
migration/export/
migration/tmp*
migration/qxc_*

# 本地 AI 工具目录 / 编辑备份
.claude/
.agents/
.codex/
skills-lock.json
*.backup

# 安全体检清单：含逐行攻击面描述（哪些检查缺门控、哪个端点无限流、绕过条件等）。
# 即使问题已修复，公开在仓库里也等于公开一份历史弱点图，因此只留本地。
AUDIT.md

# Release 说明的本地草稿（用于在 GitHub 网页粘贴；正文已进 tag 注解与 README 更新日志）
release-notes-*.md


# 打包产物
dist/
*.zip

# 系统/编辑器
.DS_Store
Thumbs.db

# 一次性迁移脚本与手册（含账号/用户隐私，永不入库）
migration/
