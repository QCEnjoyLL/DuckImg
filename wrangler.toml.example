name = "duckimg"
compatibility_date = "2024-09-23"
main = "src/index.js"

# 复制本文件为 wrangler.toml，填 database_id
# Secrets（勿写入本文件，存 Cloudflare 服务端，跨部署持久）:
#   npx wrangler secret put TG_Bot_Token
#   npx wrangler secret put TG_Chat_ID
#   npx wrangler secret put JWT_SECRET
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put ADMIN_USERNAME    # 管理员用户名
#   npx wrangler secret put RESEND_FROM       # 邮件发件人，如 "图床 <noreply@yourdomain.com>"

# 可选固定站点地址
# [vars]
# SITE_URL = "https://your-domain.com"

[[d1_databases]]
binding = "DB"
database_name = "duckimg"
database_id = "在此填入_D1_database_id"
migrations_dir = "migrations"

# 静态资源
[assets]
directory = "./public"
binding = "ASSETS"
run_worker_first = true
html_handling = "none"

# 每日清理过期限流桶与 kv_store 过期行
[triggers]
crons = ["17 3 * * *"]
